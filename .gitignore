.DS_Store

# Local agent/code-index state
.agents/
.codegraph/
.superpowers/
.freebuff
.claude


# Python caches and environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Secrets and local environment
.env
.env.*
credentials*.json
secrets*.json
*.key

# Notebook state
.ipynb_checkpoints/
notebooks/*.html
notebooks/*.pdf

# Model checkpoints
*.pt
*.pth
*.ckpt
*.safetensors

# Dataset artifacts
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep
data/manifests/*
!data/manifests/.gitkeep

# Generated experiment outputs
results/*
!results/.gitkeep
reports/*
!reports/.gitkeep
*.log

# Kaggle deployment generated state
deploy/kaggle/run_config.json
deploy/kaggle/commit_info.json

# Report artifact bundles. Human-readable evidence (reports, logs, JSON
# summaries) stays committable; these are heavy archives that duplicate
# already-ignored checkpoints, so committing them would bloat the repo.
*.zip
reports/**/checkpoints/
